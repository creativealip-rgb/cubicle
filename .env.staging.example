# Contract only. Do not copy production credentials.
DEPLOY_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.cubiqlo.com
BETTER_AUTH_URL=https://staging.cubiqlo.com
DATABASE_URL=postgresql://cubiqlo_staging_app:<staging-password>@cubiqlo-staging-pg:5432/cubicle_staging
BETTER_AUTH_SECRET=<unique-staging-secret>
R2_ACCOUNT_ID=<staging-account-or-approved-shared-account>
R2_ACCESS_KEY_ID=<staging-only-access-key>
R2_SECRET_ACCESS_KEY=<staging-only-secret-key>
R2_BUCKET_NAME=cubiqlo-staging
PAKASIR_PROJECT=
PAKASIR_API_KEY=
STAGING_PAYMENT_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=Cubiqlo Staging <qa@staging.cubiqlo.com>
STAGING_EMAIL_MODE=sink
CRON_SECRET=<unique-staging-secret>
AI_API_KEY=
RATE_LIMIT_REDIS_URL=redis://cubiqlo-staging-redis:6379
COOKIE_DOMAIN=
